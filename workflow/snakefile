    conda:
        "envs/whatshap_env.yaml"
    log:
        f"{OUTPUT_DIR}/logs/snakemake_rules/SNV_phasing_QC/{{sample}}.log"
    threads: 24
    shell:
        """
        whatshap stats \
            --tsv={output.SNV_phasing_tsv} {input} > {output.SNV_phasing_summary} \
            > {log} 2>&1
        """

